# Copy this file to secrets.toml (same folder) and fill in the values.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.
# On Streamlit Community Cloud, paste the same two lines into the app's
# Settings > Secrets box instead.

ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSCODE = "choose-a-passcode"
